# Written by `npm run setup`. Stays on your Mac (gitignored). `npm run github` copies it into GitHub secrets.
LLM_PROVIDER=gemini

# --- provider credential (only the one for your LLM_PROVIDER is needed) ---
GEMINI_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=      # LLM_PROVIDER=claude-code  (Claude Pro/Max)
# ANTHROPIC_API_KEY=            # LLM_PROVIDER=anthropic    (pay per use)

# --- optional: free stock photos and motion clips (pexels.com/api) ---
PEXELS_API_KEY=

# --- always required ---
DATABASE_URL=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- model choices (set for you by `npm run models`) ---
# Comma-separated = fallback chain: if the first is overloaded, the next is tried.
GEMINI_MODEL_HEAVY=
GEMINI_MODEL_LIGHT=

# --- backup free provider: LLM_PROVIDER=openai-compatible (Groq, OpenRouter, Cerebras, Mistral, ...) ---
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL_HEAVY=
# OPENAI_COMPAT_MODEL_LIGHT=
# OPENAI_COMPAT_VISION=false     # true only if the model accepts images
# CLAUDE_MODEL_HEAVY=opus
# CLAUDE_MODEL_LIGHT=sonnet
